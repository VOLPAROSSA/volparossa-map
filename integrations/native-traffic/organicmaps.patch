+
+namespace qt
+{
+namespace
+{
+using namespace std::chrono;
+using Info = traffic::TrafficInfo;
+constexpr size_t kMaxBytes = 2 * 1024 * 1024;
+
+struct Road
+{
+  uint32_t feature_id, segment_index, direction, speed_group, observation_count;
+};
+struct Scope
+{
+  std::string observation_counts;
+  bool independent_users_verified, anonymity_guaranteed, advisory_only, unknown_is_free_flow, unexpired_replay_detection;
+};
+struct Snapshot
+{
+  std::string format, region;
+  uint32_t map_version;
+  std::string map_sha256;
+  uint64_t window_start, window_end, expires;
+  std::vector<Road> roads;
+  Scope scope;
+};
+struct Envelope
+{
+  std::string format, publisher_key;
+  uint64_t revision;
+  std::string manifest_id;
+  Snapshot snapshot;
+};
+struct Floor
+{
+  uint64_t revision, window_end;
+  std::string manifest, digest;
+};
+struct StrictJson : glz::opts
+{
+  bool validate_trailing_whitespace = true;
+};
+constexpr StrictJson kStrict = [] { StrictJson opts; opts.error_on_missing_keys = true; return opts; }();
+
+bool Hex(std::string_view value)
+{
+  return value.size() == 64 && std::all_of(value.begin(), value.end(), [](char c)
+  { return (c >= 'a' && c <= 'f') || (c >= '0' && c <= '9'); });
+}
+
+std::string Hash(std::string const & bytes)
+{
+  return QCryptographicHash::hash(QByteArrayView(bytes), QCryptographicHash::Sha256).toHex().toStdString();
+}
+
+// Glaze enforces the field set and all required members. Count member separators outside
+// strings to also reject duplicate members, which would otherwise replace an existing member.
+size_t Members(std::string const & bytes)
+{
+  bool quoted = false, escaped = false;
+  size_t members = 0;
+  for (char c : bytes)
+  {
+    if (escaped) { escaped = false; continue; }
+    if (quoted && c == '\\') escaped = true;
+    else if (c == '"') quoted = !quoted;
+    else if (!quoted && c == ':') ++members;
+  }
+  return members;
+}
+
+bool Valid(Envelope const & envelope, uint64_t now, std::string const & publisher, std::string const & region)
+{
+  auto const & s = envelope.snapshot;
+  auto const & scope = s.scope;
+  return envelope.format == "volparossa-local-traffic-v1" && envelope.publisher_key == publisher && envelope.revision > 0 &&
+         Hex(envelope.manifest_id) && s.format == "volparossa-road-traffic-v1" && s.region == region && s.map_version > 0 &&
+         Hex(s.map_sha256) && s.window_start < s.window_end && s.window_end - s.window_start <= 300 &&
+         s.window_end <= now && now < s.expires && s.expires - s.window_end <= 300 && s.roads.size() <= 4096 &&
+         scope.observation_counts == "publisher_assertions" && scope.advisory_only && !scope.independent_users_verified &&
+         !scope.anonymity_guaranteed && !scope.unknown_is_free_flow && !scope.unexpired_replay_detection;
+}
+
+struct Fd
+{
+  explicit Fd(int n = -1) : fd(n) {}
+  Fd(Fd const &) = delete;
+  Fd & operator=(Fd const &) = delete;
+  Fd(Fd && other) : fd(std::exchange(other.fd, -1)) {}
+  ~Fd() { if (fd >= 0) close(fd); }
+  int fd;
+};
+
+bool Same(struct stat const & a, struct stat const & b)
+{
+  return a.st_dev == b.st_dev && a.st_ino == b.st_ino && a.st_mode == b.st_mode &&
+         a.st_uid == b.st_uid && a.st_nlink == b.st_nlink && a.st_size == b.st_size &&
+         a.st_mtim.tv_sec == b.st_mtim.tv_sec && a.st_mtim.tv_nsec == b.st_mtim.tv_nsec &&
+         a.st_ctim.tv_sec == b.st_ctim.tv_sec && a.st_ctim.tv_nsec == b.st_ctim.tv_nsec;
+}
+
+Fd OpenParent(std::filesystem::path const & path)
+{
+  Fd result(open("/", O_RDONLY | O_DIRECTORY | O_CLOEXEC));
+  for (auto const & item : path.parent_path().relative_path())
+  {
+    int next = openat(result.fd, item.c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+    if (next < 0) return Fd();
+    close(std::exchange(result.fd, next));
+  }
+  struct stat st{};
+  if (fstat(result.fd, &st) != 0 || st.st_uid != geteuid() || (st.st_mode & 07777) != 0700)
+    return Fd();
+  return result;
+}
+
+bool PrivateFile(int fd, struct stat & st, size_t max)
+{
+  return fd >= 0 && fstat(fd, &st) == 0 && S_ISREG(st.st_mode) && st.st_uid == geteuid() && st.st_nlink == 1 &&
+         (st.st_mode & 07777) == 0600 && st.st_size > 0 && static_cast<uint64_t>(st.st_size) <= max;
+}
+
+bool ReadStable(int fd, struct stat const & before, std::string & bytes)
+{
+  bytes.resize(static_cast<size_t>(before.st_size));
+  size_t pos = 0;
+  while (pos < bytes.size())
+  {
+    auto const n = read(fd, bytes.data() + pos, bytes.size() - pos);
+    if (n <= 0) return false;
+    pos += n;
+  }
+  struct stat after{};
+  return fstat(fd, &after) == 0 && Same(before, after);
+}
+
+// Serialize concurrent app instances and replace the durable floor atomically. An invalid existing floor fails closed. State is private to this feed slot.
+bool AdvanceFloor(int parent, std::string const & name, Floor const & next)
+{
+  if (flock(parent, LOCK_EX | LOCK_NB) != 0) return false;
+  Fd previous(openat(parent, name.c_str(), O_RDONLY | O_CLOEXEC | O_NONBLOCK | O_NOFOLLOW));
+  if (previous.fd >= 0)
+  {
+    struct stat st{};
+    Floor old{};
+    std::string bytes;
+    if (!PrivateFile(previous.fd, st, 512) || !ReadStable(previous.fd, st, bytes) || glz::read<kStrict>(old, bytes) ||
+        Members(bytes) != 4 || !old.revision || !Hex(old.manifest) || !Hex(old.digest) ||
+        next.revision < old.revision || next.window_end < old.window_end)
+      return false;
+    if (old.revision == next.revision)
+      return next.manifest == old.manifest && next.digest == old.digest;
+  }
+  else if (errno != ENOENT) return false;
+
+  auto const tmp = ".organic-traffic-" + QUuid::createUuid().toString(QUuid::WithoutBraces).toStdString();
+  Fd file(openat(parent, tmp.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600));
+  if (file.fd < 0) return false;
+  std::string bytes;
+  bool const saved = !glz::write_json(next, bytes) &&
+                     write(file.fd, bytes.data(), bytes.size()) == static_cast<ssize_t>(bytes.size()) &&
+                     fsync(file.fd) == 0 && renameat(parent, tmp.c_str(), parent, name.c_str()) == 0;
+  if (!saved) unlinkat(parent, tmp.c_str(), 0);
+  return saved && fsync(parent) == 0;
+}
+
+bool Coloring(Snapshot const & s, FeaturesLoaderGuard const & loader, Info::Coloring & coloring)
+{
+  auto const & model = routing::CarModel::AllLimitsInstance();
+  std::optional<Info::RoadSegmentId> last;
+  std::unique_ptr<FeatureType> ft;
+  size_t points = 0;
+  bool oneWay = false;
+  for (auto const & road : s.roads)
+  {
+    if (road.segment_index >= 32768 || road.direction > 1 || road.speed_group > 7 || road.speed_group == 6 ||
+        (road.speed_group != 7 && road.observation_count < 5))
+      return false;
+    Info::RoadSegmentId const key(road.feature_id, road.segment_index, road.direction);
+    if (last && !(*last < key)) return false;  // The adapter emits sorted unique directed keys.
+    if (!last || road.feature_id != last->GetFid())
+    {
+      if (road.feature_id >= loader.GetNumFeatures()) return false;
+      ft = loader.GetOriginalFeatureByIndex(road.feature_id);
+      if (!ft) return false;
+      feature::TypesHolder const types(*ft);
+      if (!model.IsRoad(types)) return false;
+      oneWay = model.IsOneWay(types);
+      ft->ParseGeometry(FeatureType::BEST_GEOMETRY);
+      points = ft->GetPointsCount();
+    }
+    if (road.segment_index + 1 >= points || (oneWay && road.direction)) return false;
+    if (road.speed_group != 7) coloring.emplace(key, static_cast<traffic::SpeedGroup>(road.speed_group));
+    last = key;
+  }
+  return true;
+}
+
+class LocalTraffic final : public QObject
+{
+public:
+  LocalTraffic(Framework & framework, std::filesystem::path path, std::string publisher, std::string region)
+    : m_framework(framework), m_path(std::move(path)), m_publisher(std::move(publisher)), m_region(std::move(region))
+  {
+    Manager().UseLocalTraffic();
+    m_timer.setTimerType(Qt::PreciseTimer);
+    connect(&m_timer, &QTimer::timeout, this, [this]() { Refresh(); });
+    m_timer.start(250);
+  }
+
+  ~LocalTraffic() override { Manager().ClearLocalTraffic(); }
+
+private:
+  TrafficManager & Manager() { return m_framework.GetTrafficManager(); }
+
+  void Clear()
+  {
+    if (Manager().HasLocalTraffic()) LOG(LINFO, ("Local advisory traffic cleared"));
+    Manager().ClearLocalTraffic();
+    m_applied = false;
+  }
+
+  void ResetMap()
+  {
+    Clear();
+    m_loader.reset();
+    m_map = {};
+    m_hash.reset();
+    m_offset = 0;
+    m_mapDigest.clear();
+  }
+
+  bool Load(int parent)
+  {
+    Fd file(openat(parent, m_path.filename().c_str(), O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_CLOEXEC));
+    struct stat st{};
+    if (!PrivateFile(file.fd, st, kMaxBytes)) return false;
+    if (m_envelope && Same(m_inputStamp, st)) return true;
+
+    Clear();
+    m_envelope.reset();
+    std::string bytes;
+    Envelope envelope{};
+    if (!ReadStable(file.fd, st, bytes) || glz::read<kStrict>(envelope, bytes) ||
+        !Valid(envelope, Now(), m_publisher, m_region) || Members(bytes) != 20 + 5 * envelope.snapshot.roads.size())
+      return false;
+    m_inputDigest = Hash(bytes);
+    m_inputStamp = st;
+    auto const remaining = system_clock::time_point(seconds(envelope.snapshot.expires)) - system_clock::now();
+    m_deadline = steady_clock::now() + duration_cast<steady_clock::duration>(remaining);
+    m_envelope = std::move(envelope);
+    return true;
+  }
+
+  uint64_t Now() const { return duration_cast<seconds>(system_clock::now().time_since_epoch()).count(); }
+
+  // Read the actual registered reader in bounded slices on the owning thread. Surface, map
+  // registration, cancellation and expiry events can run between slices even for large maps.
+  bool BindMap(Snapshot const & s)
+  {
+    auto const & data = m_framework.GetDataSource();
+    auto const id = data.GetMwmIdByCountryFile(platform::CountryFile(m_region));
+    if (!id.IsAlive() || !id.GetInfo()->IsRegistered() || id.GetInfo()->GetType() != MwmInfo::COUNTRY ||
+        id.GetInfo()->GetVersion() != s.map_version || id.GetInfo()->m_version.GetVersion() != s.map_version)
+    {
+      ResetMap();
+      return false;
+    }
+    auto const path = id.GetInfo()->GetLocalFile().GetPath(MapFileType::Map);
+    struct stat st{};
+    if (lstat(path.c_str(), &st) != 0 || !S_ISREG(st.st_mode) || st.st_size <= 0)
+    {
+      if (id == m_seenId) m_replaced = true;
+      ResetMap();
+      return false;
+    }
+    if (!(id == m_seenId))
+    {
+      m_seenId = id;
+      m_seenStamp = st;
+      m_replaced = false;
+    }
+    // A physical replacement cannot inherit the old registration, even if the file
+    // is restored. Organic Maps must register the new generation before it is trusted.
+    if (!Same(st, m_seenStamp)) m_replaced = true;
+    if (m_replaced)
+    {
+      ResetMap();
+      return false;
+    }
+    if (!(id == m_map))
+    {
+      ResetMap();
+      m_map = id;
+      m_loader = std::make_unique<FeaturesLoaderGuard>(data, id);
+      if (!m_loader->GetHandle().IsAlive() || m_loader->GetContainer().GetFileSize() != static_cast<uint64_t>(st.st_size))
+      {
+        ResetMap();
+        return false;
+      }
+    }
+    if (!m_mapDigest.empty()) return m_mapDigest == s.map_sha256;
+    auto const & reader = m_loader->GetContainer().GetFileReader();
+    auto const size = std::min<uint64_t>(reader.Size() - m_offset, m_buffer.size());
+    reader.Read(m_offset, m_buffer.data(), size);
+    m_hash.addData(QByteArrayView(m_buffer.data(), static_cast<qsizetype>(size)));
+    m_offset += size;
+    if (m_offset != reader.Size())
+    {
+      m_timer.start(1);
+      return false;
+    }
+    m_mapDigest = m_hash.result().toHex().toStdString();
+    // Check both registration and physical file identity again after the final slice.
+    m_timer.start(1);
+    return false;
+  }
+
+  void Refresh()
+  {
+    m_timer.setInterval(250);
+    try
+    {
+      Fd parent = OpenParent(m_path);
+      if (parent.fd < 0 || !Load(parent.fd))
+      {
+        m_envelope.reset();
+        ResetMap();
+        return;
+      }
+      auto const & envelope = *m_envelope;
+      auto const & s = envelope.snapshot;
+      if (!Manager().IsEnabled() || Now() >= s.expires || steady_clock::now() >= m_deadline || Now() < s.window_end)
+      {
+        ResetMap();
+        return;
+      }
+      auto const wallLeft = system_clock::time_point(seconds(s.expires)) - system_clock::now();
+      auto const steadyLeft = m_deadline - steady_clock::now();
+      auto const tick = std::min(ceil<milliseconds>(wallLeft), ceil<milliseconds>(steadyLeft));
+      m_timer.setInterval(std::clamp(tick, milliseconds(1), milliseconds(250)));
+      if (!BindMap(s))
+      {
+        Clear();
+        return;
+      }
+      if (m_applied && (m_empty || Manager().HasLocalTraffic())) return;
+      Info::Coloring coloring;
+      if (!Coloring(s, *m_loader, coloring))
+      {
+        Clear();
+        return;
+      }
+      auto const name = ".organic-traffic-" + Hash(m_publisher + "/" + m_region + "/" + std::to_string(s.map_version));
+      if (!AdvanceFloor(parent.fd, name, {envelope.revision, s.window_end, envelope.manifest_id, m_inputDigest}))
+      {
+        Clear();
+        return;
+      }
+      m_empty = coloring.empty();
+      Manager().ApplyLocalTraffic(Info::FromLocalColoring(m_map, std::move(coloring)),
+                                  system_clock::time_point(seconds(s.expires)));
+      m_applied = true;
+      LOG(LINFO, ("Local advisory traffic accepted", envelope.revision, "directed records", s.roads.size()));
+    }
+    catch (RootException const &)
+    {
+      m_envelope.reset();
+      ResetMap();
+    }
+  }
+
+  Framework & m_framework;
+  std::filesystem::path const m_path;
+  std::string const m_publisher, m_region;
+  QTimer m_timer;
+  std::optional<Envelope> m_envelope;
+  struct stat m_inputStamp{}, m_seenStamp{};
+  std::string m_inputDigest, m_mapDigest;
+  steady_clock::time_point m_deadline;
+  MwmSet::MwmId m_map, m_seenId;
+  bool m_replaced = false;
+  std::unique_ptr<FeaturesLoaderGuard> m_loader;
+  std::array<char, 1024 * 1024> m_buffer;
+  uint64_t m_offset = 0;
+  QCryptographicHash m_hash{QCryptographicHash::Sha256};
+  bool m_applied = false, m_empty = false;
+};
+}  // namespace
+
+std::unique_ptr<QObject> StartLocalTraffic(Framework & framework, std::string const & path,
+                                           std::string const & publisher, std::string const & region)
+{
+  std::filesystem::path const slot(path);
+  if (!slot.is_absolute() || slot != slot.lexically_normal() || slot.filename().empty() ||
+      slot.filename().string().starts_with(".organic-traffic-") || !Hex(publisher) || region.empty() ||
+      region.size() > 256 || region.find('/') != std::string::npos ||
+      std::any_of(region.begin(), region.end(), [](unsigned char c) { return c < 32 || c == 127; }))
+    return {};
+  return std::make_unique<LocalTraffic>(framework, slot, publisher, region);
+}
+}  // namespace qt
