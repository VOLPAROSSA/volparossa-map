+void TrafficManager::UseLocalTraffic()
+{
+  SetEnabled(false);
+  m_localOnly = true;
+  SetEnabled(true);
+}
+
+void TrafficManager::ClearLocalTraffic()
+{
+  if (!m_localTraffic)
+    return;
+  auto const id = m_localTraffic->GetMwmId();
+  m_localTraffic.reset();
+  m_drapeEngine.SafeCall(&df::DrapeEngine::ClearTrafficCache, id);
+  m_observer.OnTrafficInfoRemoved(id);
+}
+
+void TrafficManager::ApplyLocalTraffic(traffic::TrafficInfo info, std::chrono::system_clock::time_point expires)
+{
+  ClearLocalTraffic();
+  auto const remaining = expires - std::chrono::system_clock::now();
+  if (!m_localOnly || !IsEnabled() || remaining <= decltype(remaining)::zero() || !info.GetMwmId().IsAlive() ||
+      !info.GetMwmId().GetInfo()->IsRegistered() || info.GetColoring().empty())
+    return;
+  m_localExpires = expires;
+  m_localDeadline = std::chrono::steady_clock::now() +
+                    std::chrono::duration_cast<std::chrono::steady_clock::duration>(remaining);
+  m_localTraffic = std::move(info);
+  RestoreLocalTrafficLayer();
+  if (m_localTraffic)
+    m_observer.OnTrafficInfoAdded(traffic::TrafficInfo(*m_localTraffic));
+}
+
+void TrafficManager::RestoreLocalTrafficLayer()
+{
+  if (!m_localTraffic)
+    return;
+  if (std::chrono::system_clock::now() >= m_localExpires || std::chrono::steady_clock::now() >= m_localDeadline ||
+      !m_localTraffic->GetMwmId().GetInfo()->IsRegistered())
+    ClearLocalTraffic();
+  else
+    m_drapeEngine.SafeCall(&df::DrapeEngine::UpdateTraffic, *m_localTraffic);
+}
